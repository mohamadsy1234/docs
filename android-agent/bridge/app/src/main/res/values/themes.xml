<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NEXUS look: dark ground, cyan accent. Platform theme only, no AndroidX. -->
    <style name="Theme.Nexus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nexus_bg</item>
        <item name="android:statusBarColor">@color/nexus_bg</item>
        <item name="android:navigationBarColor">@color/nexus_bg</item>
        <item name="android:colorAccent">@color/nexus_cyan</item>
        <item name="android:colorPrimary">@color/nexus_cyan</item>
        <item name="android:textColorPrimary">@color/nexus_text</item>
    </style>
</resources>
